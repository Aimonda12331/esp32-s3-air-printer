# ==============================================================================
# ESP-IDF & ESP32-S3 Air Printer - Git Ignore
# ==============================================================================

# --- ESP-IDF Build Outputs ---
build/
**/build/
*.bin
*.elf
*.map
flasher_args.json

# --- ESP-IDF Configurations ---
# Giữ lại 'sdkconfig' vì dự án lưu cấu hình 16MB Flash, Octal PSRAM và phân vùng.
# Chỉ bỏ qua các tệp sao lưu cấu hình tạm thời:
sdkconfig.old
sdkconfig.ci
sdkconfig.rename

# --- ESP-IDF Component Manager ---
# Thư mục thư viện tải tự động từ Espressif Registry (led_strip, mdns, ...)
managed_components/
dependencies.lock.old

# Caches nội bộ của Espressif
/components/.idf/
**/components/.idf/
.espressif/

# --- CMake Artifacts ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
compile_commands.json

# --- Binaries & Object Files ---
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# --- VS Code & IDE Caches ---
# Giữ lại cấu hình workspace cần thiết, loại bỏ cache và log
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
!.vscode/tasks.json
!.vscode/launch.json
.vscode/*.log
.vscode/ipch/
.vscode/.browse.*

# --- Language Servers (Clangd / CCLS) ---
.clangd/
.ccls-cache/

# --- Python Environments & Caches (ESP-IDF tools) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
venv/
.venv/
env/

# --- Temporary & Backup Files ---
*~
*.swp
*.swo
*.bak
*.tmp
*.log

# --- OS Specific Files ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
